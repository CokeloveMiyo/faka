# ===== 基础 =====
# 服务端口
PORT=3789
# 对外访问地址（用于拼 V免签 回调/跳转链接，末尾不带斜杠）
# 本地测试：http://127.0.0.1:3789
# 上线后改成你的域名：https://faka.example.com
BASE_URL=http://127.0.0.1:3789

# ===== 管理后台 =====
# 管理员密码（务必改成强密码）
ADMIN_PASSWORD=change-me-please
# 会话签名密钥（随机长字符串，改掉后所有登录失效）
SESSION_SECRET=please-replace-with-a-long-random-string

# ===== V免签 对接 =====
# V免签程序地址，末尾不带斜杠
VMQ_URL=http://127.0.0.1:8000
# V免签 商户通讯密钥（V免签后台设置的 key，绝不暴露给前端）
VMQ_KEY=your-vmq-merchant-key

# 同价订单防冲突：1 开启（同价待支付订单会依次加 1~2 分钱），0 关闭
PRICE_JITTER=1
